FROM mmontuori/osbase:latest
RUN sed -i 's:^path-exclude=/usr/share/man:#path-exclude=/usr/share/man:' /etc/dpkg/dpkg.cfg.d/excludes
RUN apt-get update && \
    export DEBIAN_FRONTEND=noninteractive && \
    apt-get install --no-install-recommends -y \
        arping \
        arptables \
        bridge-utils \
        ca-certificates \
        conntrack \
        curl \
        dnsutils \
        ethtool \
        iperf \
        iperf3 \
        iproute2 \
        strongswan \
        ipset \
        iptables \
        iputils-ping \
        jq \
        kmod \
        ldap-utils \
        less \
        libpcap-dev \
        sysstat \
        man \
        manpages-posix \
        mtr \
        net-tools \
        netcat-openbsd \
        openssl \
        openssh-client \
        psmisc \
        socat \
        tcpdump \
        telnet \
        tmux \
        traceroute \
        tcptraceroute \
        tree \
        ngrep \
        vim \
        wget

RUN rm -rf /var/lib/apt/lists/* && \
    curl -ksLf https://get.docker.com/builds/Linux/x86_64/docker-1.10.3 > /usr/bin/docker && \
    chmod +x /usr/bin/docker && \
    curl -ksLf https://storage.googleapis.com/kubernetes-release/release/v1.16.8/bin/linux/$(dpkg --print-architecture)/kubectl > /usr/local/bin/kubectl-1.16 && \
    curl -ksLf https://storage.googleapis.com/kubernetes-release/release/v1.17.4/bin/linux/$(dpkg --print-architecture)/kubectl > /usr/local/bin/kubectl-1.17 && \
    curl -ksLf https://storage.googleapis.com/kubernetes-release/release/v1.18.0/bin/linux/$(dpkg --print-architecture)/kubectl > /usr/local/bin/kubectl-1.18 && \
    chmod +x /usr/local/bin/kubectl* && \
    ln -s /usr/local/bin/kubectl-1.18 /usr/local/bin/kubectl && \
    sudo wget --no-check-certificate -qO /usr/local/bin/yq https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 && \
    sudo chmod a+x /usr/local/bin/yq && \
    mkdir -p /root/.kube

COPY files/install-wirt.sh /usr/local/bin/install-wirt.sh
RUN chmod +x /usr/local/bin/install-wirt.sh && \
    /usr/local/bin/install-wirt.sh

RUN curl -ksS https://starship.rs/install.sh > /tmp/install.sh
RUN chmod +x /tmp/install.sh && \
    /tmp/install.sh --yes && \
    rm -f /tmp/install.sh
RUN curl --proto '=https' -kLsSf https://setup.atuin.sh | sh -s -- --non-interactive

RUN apt-get update
RUN apt-get install apt-transport-https wget --yes
RUN wget -O /tmp/kubecolor.deb https://kubecolor.github.io/packages/deb/pool/main/k/kubecolor/kubecolor_$(wget -q -O- https://kubecolor.github.io/packages/deb/version)_$(dpkg --print-architecture).deb
RUN dpkg -i /tmp/kubecolor.deb
RUN apt update

RUN cd /tmp && \
    wget --no-check-certificate https://mirror.openshift.com/pub/openshift-v4/clients/oc/latest/linux/oc.tar.gz && \
    tar xvfz oc.tar.gz && \ 
    mv oc /usr/local/bin/ && \
    mv kubectl /usr/local/bin/ && \
    rm /tmp/*

WORKDIR /root
