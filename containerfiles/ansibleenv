FROM mmontuori/osbase:latest
ENV ANSIBLE_VERSION 9.6.0
RUN apt-get update
RUN apt-get install -y gcc python3
RUN apt install -y python3-pip software-properties-common ansible-lint pylint shellcheck
RUN apt clean all
COPY files/pip.conf /etc
#RUN pip3 install --upgrade pip
RUN apt install -y ansible
RUN apt install -y python3-jmespath
#RUN python3 -m pip install ansible-navigator
COPY files/ansiblelintwrapper /usr/local/bin
RUN chmod 755 /usr/local/bin/ansiblelintwrapper
RUN apt clean autoclean
RUN apt autoremove --yes
RUN rm -rf /var/lib/{apt,dpkg,cache,log}/

